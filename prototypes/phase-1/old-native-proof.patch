+  // Edit a text entry in the preview pane. Saving copies the result to the
+  // clipboard; the capture watcher then files it as a fresh history entry, so
+  // the original is left alone and nothing has to rewrite history.json.
+  function editIndex(index) {
+    if (!root.cursorActive || index < 0 || index >= displayModel.count) return
+
+    var row = displayModel.get(index)
+    if (row.entryType === "image") return
+
+    editor.text = row.fullText
+    root.editing = true
+    Qt.callLater(function() {
+      editor.forceActiveFocus()
+      editor.cursorPosition = editor.length
+    })
+  }
+
+  function cancelEdit() {
+    root.editing = false
+    Qt.callLater(function() { keyCatcher.forceActiveFocus() })
+  }
+
+  function saveEdit() {
+    if (!root.editing) return
+
+    var text = editor.text
+    root.editing = false
+    root.opened = false
+    if (text.length === 0) return
+
+    copyProc.payload = text
+    copyProc.running = true
+  }
+
+  // The text goes over stdin, never argv: a clipboard entry can easily exceed
+  // MAX_ARG_STRLEN, and exec would fail with E2BIG and lose the edit silently.
+  Process {
+    id: copyProc
+    property string payload: ""
+    command: ["wl-copy"]
+    stdinEnabled: true
+    onStarted: {
+      write(payload)
+      payload = ""
+      stdinEnabled = false
+    }
+  }
+
   Component.onCompleted: initProc.running = true
 
